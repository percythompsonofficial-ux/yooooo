# Postgres. Neon and Supabase both hand you a string in this shape.
DATABASE_URL=postgresql://user:password@host/dbname

# Needed to generate. Reviewing and exporting work without it.
ANTHROPIC_API_KEY=

# Shared secret for the worker at /api/jobs/run. Required in production —
# that endpoint spends money, so it refuses to run unauthenticated there.
# Vercel Cron sends it as `Authorization: Bearer $CRON_SECRET`.
CRON_SECRET=

# Worker tuning (optional).
# JOB_BUDGET_MS=50000     # stop claiming past this, under the platform's cap
# JOB_CONCURRENCY=3       # jobs in flight at once; each is one model call
# JOB_MAX_PER_RUN=0       # cap model calls per invocation; 0 = no cap
