# Notes generation — required.
ANTHROPIC_API_KEY=

# Transcription — set ONE of these.
# Deepgram is strongly preferred: no upload size limit, and it labels speakers
# so the professor is separated from questions asked from the room.
DEEPGRAM_API_KEY=

# Fallback. Whisper rejects uploads over 25 MB, which is roughly 70 minutes at
# this app's bitrate, so a long lecture may not fit.
OPENAI_API_KEY=

# Which model writes the notes. Defaults to claude-sonnet-5.
# Set to claude-opus-5 for sharper judgement on exam signals, at ~2x the cost.
ANTHROPIC_MODEL=

# Locks a deployed instance. Required in production, ignored by `npm run dev`.
# Make it long — there is no lockout, only a small delay per wrong guess.
APP_PASSWORD=
